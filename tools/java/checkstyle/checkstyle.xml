      <property name="severity" value="warning"/>
      <property name="format" value="^[A-Z]$|^[A-Z][a-z]+(?:[A-Z][a-z]+)*$"/>
      <message key="name.invalidPattern" value="[JV-TG-029] 泛型參數命名 → rules/stacks/java/common/types-and-generics.md#java-type-parameter-names"/>
    </module>
