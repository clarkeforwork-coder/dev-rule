<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- 由 rule-map 對照；候選僅保留於 candidates.xml，不納入預設阻擋。 -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="fileExtensions" value="java"/>
  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.suppressions.file}" default="tools/java/checkstyle/suppressions.xml"/>
  </module>
    <!-- JV-ER-013：verified；Checkstyle 無內建規則；純文字 regex 作為不解析 AST 時的最低限度檢查；；誤報風險說明：只抓空 catch 區塊）；；實證版本：17；設定：[format=catch\s*\(\s*(final\s+)?InterruptedException\s+\w+\s*\)\s*\{\s*\}]。 -->
    <module name="RegexpMultiline">
      <property name="id" value="JV-ER-013"/>
      <property name="severity" value="error"/>
      <property name="format" value="catch\s*\(\s*(final\s+)?InterruptedException\s+\w+\s*\)\s*\{\s*\}"/>
      <property name="message" value="[JV-ER-013] 保留中斷意圖 → rules/stacks/java/common/exceptions-and-resources.md#java-interruption"/>
      <property name="maximum" value="0"/>
    </module>
  <module name="TreeWalker">
    <!-- JV-TG-001：verified；純文字規則，format="(^|[\s(,])var\s+[A-Za-z_$][\w$]*\s*(=|:|\)|,)"，ignoreComments=true；同時抓區域變數 var 與 Lambda 的 (var x)；字串常值內出現同樣文字會誤報（罕見）；PMD 版較準確；若 pre-commit 只跑一個工具，二選一即可；；實證版本：17、11、8；設定：(id=NoVar)。 -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="JV-TG-001"/>
      <property name="severity" value="error"/>
      <property name="format" value="(^|[\s(,])var\s+[A-Za-z_$][\w$]*\s*(=|:|\)|,)"/>
      <property name="message" value="[JV-TG-001] 明確宣告型別 → rules/stacks/java/common/types-and-generics.md#java-explicit-types"/>
      <property name="maximum" value="0"/>
      <property name="ignoreComments" value="true"/>
    </module>
    <!-- JV-TG-011：verified；format="^\s*(rawtypes|unchecked|all)\s*$"；既有程式碼與工具生成碼常見此類抑制，需 SuppressionFilter 或依規範治理的例外清單；Lombok／MapStruct 生成碼請以 generated 目錄排除；；實證版本：17。 -->
    <module name="SuppressWarnings">
