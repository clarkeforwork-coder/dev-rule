<!-- 將 properties、profiles、build 合併到專案 pom；此檔是可解析的範例，不是父 POM。
     建置外掛檢查工作目錄整檔；新增行判定由 hooks/pre-commit 負責。
     Maven 的執行 JDK 決定 Checkstyle 版本；targetJdk 對應專案 source level。 -->
<project xmlns='http://maven.apache.org/POM/4.0.0' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd'>
  <modelVersion>4.0.0</modelVersion>
  <groupId>example</groupId>
  <artifactId>dev-rule-integration</artifactId>
  <version>1.0.0</version>
  <properties>
    <dev-rule.root>${maven.multiModuleProjectDirectory}/vendor/dev-rule</dev-rule.root>
    <checkstyle.version>10.26.1</checkstyle.version>
    <pmd.version>7.29.0</pmd.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <dev-rule.java.range>[17,18)</dev-rule.java.range>
    <!-- 範例禁用清單；採用端須按核准政策調整，無需求則移除對應規則。 -->
    <dev-rule.banned>commons-logging:commons-logging</dev-rule.banned>
    <dev-rule.boundary.banned>javax.servlet:javax.servlet-api</dev-rule.boundary.banned>
  </properties>
  <profiles>
    <profile>
      <id>dev-rule-jdk8</id>
      <activation>
        <jdk>[1.8,1.9)</jdk>
      </activation>
      <properties>
        <checkstyle.version>9.3</checkstyle.version>
      </properties>
    </profile>
    <!-- 明確啟用：mvn -Pdev-rule-baseline verify；只替換 PMD／Checkstyle 違規門檻。 -->
    <profile>
      <id>dev-rule-baseline</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <configuration>
              <failOnViolation>false</failOnViolation>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <configuration>
              <failOnViolation>false</failOnViolation>
            </configuration>
          </plugin>
          <!-- 合併後位於既有報告外掛之後，在 verify 內最後檢查。 -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>dev-rule-baseline</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>sh</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>${dev-rule.root}/tools/java/baseline/run.sh</argument>
                    <argument>check</argument>
                    <argument>--baseline</argument>
                    <argument>${project.basedir}/dev-rule-baseline.tsv</argument>
                    <argument>--pmd</argument>
                    <argument>${project.build.directory}/pmd.xml</argument>
                    <argument>--checkstyle</argument>
                    <argument>${project.build.directory}/checkstyle-result.xml</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${dev-rule.root}/tools/java/checkstyle/checkstyle.xml</configLocation>
          <suppressionsLocation>${dev-rule.root}/tools/java/checkstyle/suppressions.xml</suppressionsLocation>
          <suppressionsFileExpression>checkstyle.suppressions.file</suppressionsFileExpression>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <violationSeverity>error</violationSeverity>
          <consoleOutput>true</consoleOutput>
        </configuration>
        <executions>
          <execution>
            <id>dev-rule-checkstyle</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
        <dependencies>
          <dependency>
            <groupId>net.sourceforge.pmd</groupId>
            <artifactId>pmd-core</artifactId>
            <version>${pmd.version}</version>
          </dependency>
          <dependency>
            <groupId>net.sourceforge.pmd</groupId>
            <artifactId>pmd-java</artifactId>
            <version>${pmd.version}</version>
          </dependency>
          <dependency>
            <groupId>net.sourceforge.pmd</groupId>
            <artifactId>pmd-javascript</artifactId>
            <version>${pmd.version}</version>
          </dependency>
          <dependency>
            <groupId>net.sourceforge.pmd</groupId>
            <artifactId>pmd-jsp</artifactId>
            <version>${pmd.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <rulesets>
            <ruleset>${dev-rule.root}/tools/java/pmd/ruleset.xml</ruleset>
          </rulesets>
          <targetJdk>${maven.compiler.source}</targetJdk>
          <includeTests>true</includeTests>
          <failurePriority>2</failurePriority>
          <printFailingErrors>true</printFailingErrors>
        </configuration>
        <executions>
          <execution>
            <id>dev-rule-pmd</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <fork>true</fork>
          <showWarnings>true</showWarnings>
          <executable>${dev-rule.root}/tools/java/ci/compiler/javac.sh</executable>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.8.6.6</version>
        <configuration>
          <threshold>Low</threshold>
          <effort>Default</effort>
          <includeFilterFile>${dev-rule.root}/tools/java/spotbugs/include.xml</includeFilterFile>
          <excludeFilterFile>${dev-rule.root}/tools/java/spotbugs/exclude.xml</excludeFilterFile>
          <xmlOutput>true</xmlOutput>
          <includeTests>true</includeTests>
          <failOnError>true</failOnError>
        </configuration>
        <executions>
          <execution>
            <id>dev-rule-spotbugs</id>
            <phase>verify</phase>
            <goals>
              <goal>spotbugs</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions><execution><id>dev-rule-enforce</id><goals><goal>enforce</goal></goals>
          <configuration><failFast>true</failFast><rules>
            <!-- JV-VP-001：僅限制 Maven 執行 JDK。 -->
            <requireJavaVersion><version>${dev-rule.java.range}</version>
              <message>[JV-VP-001] 分別記錄版本資訊 → rules/stacks/java/common/version-policy.md#java-version-declarations</message>
            </requireJavaVersion>
            <requireProperty><property>dev-rule.banned</property><regex>.*\S.*</regex>
              <message>請設定非空 dev-rule.banned；無禁用需求請移除對應 requireProperty 與 bannedDependencies</message>
            </requireProperty>
            <!-- JV-VP-010：已評估不相容版本的禁止清單，不可只用範例 GAV。 -->
            <bannedDependencies><searchTransitive>true</searchTransitive>
              <excludes><exclude>${dev-rule.banned}</exclude></excludes>
              <message>[JV-VP-010] 依賴版本要求 → rules/stacks/java/common/version-policy.md#java-dependency-versions</message>
            </bannedDependencies>
            <!-- JV-VP-011：收斂與上界都是同一小節的輔助限制。 -->
            <dependencyConvergence><message>[JV-VP-011] 依賴版本要求 → rules/stacks/java/common/version-policy.md#java-dependency-versions</message></dependencyConvergence>
            <requireUpperBoundDeps><message>[JV-VP-011] 依賴版本要求 → rules/stacks/java/common/version-policy.md#java-dependency-versions</message></requireUpperBoundDeps>
          </rules></configuration>
        </execution>
        <execution><id>dev-rule-boundaries</id><goals><goal>enforce</goal></goals>
          <configuration><failFast>true</failFast><rules>
            <requireProperty><property>dev-rule.boundary.banned</property><regex>.*\S.*</regex>
              <message>請設定非空 dev-rule.boundary.banned；無禁用需求請移除對應 requireProperty 與 bannedDependencies</message>
            </requireProperty>
            <!-- JV-NP-028：獨立於版本禁用清單，每個模組依核准架構設定。 -->
            <bannedDependencies><searchTransitive>true</searchTransitive>
              <excludes><exclude>${dev-rule.boundary.banned}</exclude></excludes>
              <message>[JV-NP-028] 套件與架構邊界 → rules/stacks/java/common/naming-packages-docs.md#java-package-boundaries</message>
            </bannedDependencies>
          </rules></configuration>
        </execution></executions>

      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>dev-rule-classpath</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/dev-rule-classpath</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>dev-rule-bytecode</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${dev-rule.root}/tools/java/ci/verify.sh</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>${project.build.directory}/dev-rule-classpath</argument>
                <argument>${project.build.directory}/spotbugsXml.xml</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.4.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
