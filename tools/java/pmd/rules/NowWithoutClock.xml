<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-ND-024 -->
  <rule name="NowWithoutClock" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-ND-024] 可控制的時間基準 → rules/stacks/java/common/numbers-dates-text.md#java-clock-source" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/numbers-dates-text.md#java-clock-source">
    <description>Instant.now(clock)、source.instant() 不報；實測 PMD 在 JDK 8／11／17／21 執行期下結果一致；；誤報風險說明：測試碼、日誌時間戳、非業務用途的計時會被報；以 package／測試來源集排除，或在組態／Clock 供應者處抑制；System.nanoTime 等單調來源刻意不報；；實證版本：17、8、11、21；補充實證：samples/SubClauses.java:36,50,51 new Date()／currentTimeMillis()／LocalDate.now() caught。</description>
    <priority>3</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//MethodCall[@MethodName='now'][ArgumentList/@Size = 0][TypeExpression/ClassType[pmd-java:typeIs('java.time.temporal.TemporalAccessor')]] | //MethodCall[pmd-java:matchesSig('java.lang.System#currentTimeMillis()')] | //ConstructorCall[pmd-java:matchesSig('java.util.Date#new()')] | //MethodCall[pmd-java:matchesSig('java.util.Calendar#getInstance()')]]]></value></property>
    </properties>
  </rule>
</ruleset>
