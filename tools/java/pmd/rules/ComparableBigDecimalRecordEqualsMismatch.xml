<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-ND-014 -->
  <rule name="ComparableBigDecimalRecordEqualsMismatch" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-ND-014] BigDecimal 判同語意 → rules/stacks/java/common/numbers-dates-text.md#java-decimal-equivalence" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/numbers-dates-text.md#java-decimal-equivalence">
    <description>只適用 record（Java 16+）；Java 8 符合範例為一般類別、自行實作三者，不在範圍（實測不報）；；誤報風險說明：record 以 BigDecimal.compareTo 排序卻沿用自動 equals，compareTo==0 與 equals 必然不一致；；實證版本：17、8。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//RecordDeclaration[ImplementsList/ClassType[pmd-java:typeIs('java.lang.Comparable')]][RecordComponentList/RecordComponent/ClassType[pmd-java:typeIs('java.math.BigDecimal')]][RecordBody/MethodDeclaration[@Name='compareTo']//MethodCall[@MethodName='compareTo'][*[1][pmd-java:typeIs('java.math.BigDecimal')]]][not(RecordBody/MethodDeclaration[@Name='equals'])][not(RecordBody/*[self::CompactConstructorDeclaration or self::ConstructorDeclaration]//MethodCall[@MethodName=('stripTrailingZeros','setScale')])]]]></value></property>
    </properties>
  </rule>
</ruleset>
