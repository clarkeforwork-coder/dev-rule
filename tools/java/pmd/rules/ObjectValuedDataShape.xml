<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-TG-017 -->
  <rule name="ObjectValuedDataShape" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-TG-017] 業務資料結構 → rules/stacks/java/common/types-and-generics.md#java-business-data-shape" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/types-and-generics.md#java-business-data-shape">
    <description>回傳值、欄位、參數或 record 元件型別為 Map&lt;?, Object&gt; 或 Object[]；JSON／框架 Model（Spring Model attributes、JDBC 列）在邊界層合法，需對邊界套件 exclude；真正動態映射改用明確值型別即可通過；；實證版本：17、8。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//(MethodDeclaration|FieldDeclaration|FormalParameter|RecordComponent)
  /(ClassType[pmd-java:typeIs('java.util.Map')]/TypeArguments/ClassType[2][pmd-java:typeIsExactly('java.lang.Object')]
    | ArrayType[ClassType[pmd-java:typeIsExactly('java.lang.Object')]])]]></value></property>
    </properties>
  </rule>
</ruleset>
