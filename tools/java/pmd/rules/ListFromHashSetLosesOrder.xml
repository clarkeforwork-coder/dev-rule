<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-CO-003 -->
  <rule name="ListFromHashSetLosesOrder" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-CO-003] 順序與重複資料 → rules/stacks/java/common/collections-and-ownership.md#java-order-and-duplicates" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/collections-and-ownership.md#java-order-and-duplicates">
    <description>只抓「List ← HashSet 建構」這一種失去順序與重複值的寫法；Set.of／Map.of 不保證順序、SequencedSet 不保留重複等屬契約判斷，見同節 manual 筆；；誤報風險說明：刻意用 HashSet 去重再排序的寫法也會被報；用 LinkedHashSet／TreeSet 表達意圖者不報；建議 warn 並允許 @SuppressWarnings；；實證版本：17、21。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//ConstructorCall[pmd-java:typeIs('java.util.List')]/ArgumentList/ConstructorCall[pmd-java:typeIsExactly('java.util.HashSet')]]]></value></property>
    </properties>
  </rule>
</ruleset>
