<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-LS-016 -->
  <rule name="LambdaCatchWithoutRethrow" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-LS-016] 維持錯誤分類 → rules/stacks/java/common/lambda-and-stream.md#java-failure-classification" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/lambda-and-stream.md#java-failure-classification">
    <description>Lambda 內的 catch 沒有任何 throw（吞錯或回傳替代值）；允許部分成功且保留各筆結果的流程（catch 後記錄到結果物件）會被抓，需 suppress；內建 EmptyCatchBlock／AvoidCatchingGenericException 抓不到此範例（catch 非空、型別具體）；；實證版本：17、8。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//CatchClause[ancestor::LambdaExpression][not(Block//ThrowStatement)]]]></value></property>
    </properties>
  </rule>
</ruleset>
