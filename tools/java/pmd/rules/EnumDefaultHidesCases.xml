<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-SR-008 -->
  <rule name="EnumDefaultHidesCases" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-SR-008] 處理完整性 → rules/stacks/java/common/states-and-results.md#java-exhaustive-result-handling" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/states-and-results.md#java-exhaustive-result-handling">
    <description>僅審查候選：抓 enum 缺少明列常數且有 default；不判斷成功語意；補強測試顯示 default throw 也會被抓，不能直接作阻擋門檻，須核定完整明列契約及例外；已實跑；未通過違反命中或符合不誤報時屬淘汰候選，不是可啟用規則；；實證版本：11、17、21。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//(SwitchStatement | SwitchExpression)[@EnumSwitch = true()][@ExhaustiveEnumSwitch = false()][*/SwitchLabel[@Default = true()]]]]></value></property>
    </properties>
  </rule>
</ruleset>
