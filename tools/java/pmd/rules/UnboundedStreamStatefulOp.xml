<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-CO-012 -->
  <rule name="UnboundedStreamStatefulOp" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-CO-012] 限制資料累積 → rules/stacks/java/common/collections-and-ownership.md#java-bounded-accumulation" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/collections-and-ownership.md#java-bounded-accumulation">
    <description>Java 11 符合範例用三參數 iterate（有停止條件）→ 不報；Java 8／17 符合範例 limit 在 sorted 之前 → 不報；；誤報風險說明：只針對 Stream.generate／二參數 Stream.iterate 這類確定無界的來源，且 limit／takeWhile 不在 sorted／distinct 之前；；實證版本：17、8、11。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//MethodCall[@MethodName=('sorted','distinct')][descendant::MethodCall[TypeExpression/ClassType[pmd-java:typeIs('java.util.stream.BaseStream')]][@MethodName='generate' or (@MethodName='iterate' and ArgumentList/@Size=2)]][not(descendant::MethodCall[@MethodName=('limit','takeWhile')])]]]></value></property>
    </properties>
  </rule>
</ruleset>
