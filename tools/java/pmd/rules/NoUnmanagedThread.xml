<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-CA-002 -->
  <rule name="NoUnmanagedThread" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-CA-002] 統一管理執行資源 → rules/stacks/java/common/concurrency-and-async.md#java-execution-resources" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/concurrency-and-async.md#java-execution-resources">
    <description>採用：限定非資源管理元件；ThreadFactory、測試基礎設施及核准擁有者需精確例外；不涵蓋 Thread.ofVirtual().start 等其他建立 API，也不證明容量管理；實證：bad-17=1, good-17=0, good-21=0；詳 pmd-results.json；；實證版本：17、21。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//ConstructorCall[pmd-java:typeIs('java.lang.Thread')]]]></value></property>
    </properties>
  </rule>
</ruleset>
