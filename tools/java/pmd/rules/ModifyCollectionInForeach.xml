<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-CO-007 -->
  <rule name="ModifyCollectionInForeach" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-CO-007] 遍歷期間的修改 → rules/stacks/java/common/collections-and-ownership.md#java-traversal-mutation" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/collections-and-ownership.md#java-traversal-mutation">
    <description>PMD 7 XPath；pre-commit 層的對應規則；；誤報風險說明：同 Error Prone，remove 後 break 會被報；只比對變數名稱，被遍歷集合若是方法回傳值（for (x : get())）則抓不到；；實證版本：17。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//MethodCall[@MethodName = ('add','addAll','remove','removeAll','removeIf','retainAll','clear','set','sort','put','putAll','putIfAbsent','replaceAll')][*[1][self::VariableAccess or self::FieldAccess]/@Name = ancestor::ForeachStatement/*[2][self::VariableAccess or self::FieldAccess]/@Name][not(ancestor::LambdaExpression[ancestor::ForeachStatement])]]]></value></property>
    </properties>
  </rule>
</ruleset>
