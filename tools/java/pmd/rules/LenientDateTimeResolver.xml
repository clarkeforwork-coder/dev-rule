<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-ND-029 -->
  <rule name="LenientDateTimeResolver" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-ND-029] 解析與輸出契約 → rules/stacks/java/common/numbers-dates-text.md#java-temporal-parsing-formatting" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/numbers-dates-text.md#java-temporal-parsing-formatting">
    <description>；誤報風險說明：明確指定 SMART／LENIENT 幾乎都是刻意放寬，與條文「不允許寬鬆修正非法日期」直接衝突；；實證版本：17。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//MethodCall[@MethodName='withResolverStyle']/ArgumentList/FieldAccess[@Name=('SMART','LENIENT')][TypeExpression/ClassType[pmd-java:typeIs('java.time.format.ResolverStyle')]]]]></value></property>
    </properties>
  </rule>
</ruleset>
