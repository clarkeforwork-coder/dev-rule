<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-LS-018 -->
  <rule name="StreamVariableReused" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-LS-018] 明確消費範圍 → rules/stacks/java/common/lambda-and-stream.md#java-stream-consumption" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/lambda-and-stream.md#java-stream-consumption">
    <description>型別為 Stream 的區域變數在同一方法內被讀取兩次以上（XPath 3.1 let）；Stream 變數重新指派（s = s.filter(...)）或先 try-with-resources 再消費一次的合法寫法會誤報；欄位型 Stream 與跨方法共用不抓；SpotBugs／Error Prone 2.52 皆無「重用已消費 Stream」檢查；；實證版本：17、8。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//VariableId[@LocalVariable = true()][pmd-java:typeIs('java.util.stream.BaseStream')]
  [let $n := @Name return count(ancestor::MethodDeclaration//VariableAccess[@Name = $n][@AccessType = 'READ']) > 1]]]></value></property>
    </properties>
  </rule>
</ruleset>
