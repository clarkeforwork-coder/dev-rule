<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-ND-013 -->
  <rule name="BigDecimalRecordWithoutNormalization" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-ND-013] BigDecimal 判同語意 → rules/stacks/java/common/numbers-dates-text.md#java-decimal-equivalence" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/numbers-dates-text.md#java-decimal-equivalence">
    <description>寬鬆版啟發式；被 ComparableBigDecimalRecordEqualsMismatch 取代；；誤報風險說明：實測誤報 numbers-dates-text.md java-numeric-representation 的符合範例 record Amount(BigDecimal value)；小數位數是否屬語意需契約決定；不建議採用，列出以記錄已試過；；實證版本：17、8。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//RecordDeclaration[RecordComponentList/RecordComponent/ClassType[pmd-java:typeIs('java.math.BigDecimal')]][not(RecordBody/MethodDeclaration[@Name='equals'])][not(RecordBody/*[self::CompactConstructorDeclaration or self::ConstructorDeclaration]//MethodCall[@MethodName=('stripTrailingZeros','setScale')])]]]></value></property>
    </properties>
  </rule>
</ruleset>
