<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-NO-003 -->
  <rule name="OptionalReturnNull" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-NO-003] Optional 本身非空 → rules/stacks/java/common/null-and-optional.md#java-optional-nonnull" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/null-and-optional.md#java-optional-nonnull">
    <description>只涵蓋 java.util.Optional 方法直接 return null；間接變數回傳、欄位與參數為缺口，補強反例已證明 indirectNull 不被抓；已實跑；未通過違反命中或符合不誤報時屬淘汰候選，不是可啟用規則；；實證版本：17。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//ReturnStatement/NullLiteral[ancestor::MethodDeclaration[1]/ClassType[pmd-java:typeIs('java.util.Optional')]][not(ancestor::LambdaExpression)]]]></value></property>
    </properties>
  </rule>
</ruleset>
