<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java 共通規範" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>依 tools/java/rule-map.yml 建立；候選規則不在預設集合。</description>
  <!-- JV-RS-002 -->
  <rule name="ReviewReflectiveFieldWrite" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule" message="[JV-RS-002] 維持封裝與不變條件 → rules/stacks/java/common/reflection-and-suppression.md#java-reflective-encapsulation" externalInfoUrl="https://github.com/clarkeforwork-coder/dev-rule/blob/main/rules/stacks/java/common/reflection-and-suppression.md#java-reflective-encapsulation">
    <description>條件式採用：標出 Field 寫入供封裝審查，不能從語法判定業務不變條件；序列化框架與合法映射需逐點核准；未配置例外前不適合整個儲存庫直接阻擋；實證：bad-17=1, good-17=0；詳 pmd-results.json；；實證版本：17。</description>
    <priority>1</priority>
    <properties>
      <property name="xpath"><value><![CDATA[//MethodCall[@MethodName = ('set','setBoolean','setByte','setChar','setShort','setInt','setLong','setFloat','setDouble')][*[1][pmd-java:typeIs('java.lang.reflect.Field')]]]]></value></property>
    </properties>
  </rule>
</ruleset>
